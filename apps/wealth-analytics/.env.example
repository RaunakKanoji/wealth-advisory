GOOGLE_API_KEY=
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VANNA_ENABLE_AGENT=false
ANALYTICS_MAX_ROWS=500
ANALYTICS_STATEMENT_TIMEOUT_MS=5000
