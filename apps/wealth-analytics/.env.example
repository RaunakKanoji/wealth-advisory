ANALYTICS_HOST=0.0.0.0
ANALYTICS_PORT=8001
VANNA_DATABASE_URL=postgresql://wealth_analytics_reader:change-me@host/neondb?sslmode=require
VANNA_SERVICE_SECRET=change-me
