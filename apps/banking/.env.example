# Environment configuration (F007). Copy to `.env` for local development.
#
# Every EXPO_PUBLIC_* variable is inlined into the client bundle and is PUBLIC.
# Never put secrets, API keys, or privileged credentials in this file or in any
# EXPO_PUBLIC_* variable. Validation rules live in `lib/env.ts`.

# One of: development | preview | production. Defaults to development.
EXPO_PUBLIC_APP_ENV=development

# Bank API gateway base URL. Optional while deterministic mock mode is enabled;
# required for remote mode and HTTPS-only in production.
# iOS Simulator: use loopback when the API runs on the same Mac.
# Physical devices: use a reachable Mac LAN address or an HTTPS deployment.
# Keep the API separate from Expo Metro's default 8081 port.
# Loopback is rewritten to the Expo CLI LAN host during native development.
# Use a reachable HTTPS URL for preview/production builds.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
# When set alongside EXPO_PUBLIC_USE_MOCK_DATA=false, screens use the
# authenticated backend/Neon data layer. This URL is public; it must never
# contain a database URL or privileged credential.

# Explicit development-only selector for the seeded demo API identity. It is
# ignored unless EXPO_PUBLIC_ALLOW_DEMO_AUTH=true and EXPO_PUBLIC_APP_ENV is
# not production. Live builds always send the Clerk session token.
# EXPO_PUBLIC_DEMO_AUTH_ID=demo-customer-a
# EXPO_PUBLIC_ALLOW_DEMO_AUTH=false

# Explicit mock mode: "true" routes integration-facing features to their
# deterministic development adapters. Must not be set in production.
# EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_USE_MOCK_DATA=false

# Live data always uses the authenticated Coach API.
# Opt into fixtures only by explicitly setting EXPO_PUBLIC_USE_MOCK_DATA=true.
# Set this to false for a self-contained build that uses the local Coach demo
# adapter; it has no effect when demo/mock mode is enabled.
# EXPO_PUBLIC_REMOTE_COACH_ENABLED=true

# Development feature flag overrides ("true"/"false"). Honored in development
# and preview only; defaults live in `src/config/featureFlags.ts`.
# EXPO_PUBLIC_FLAG_COPILOT_VOICE=false
# EXPO_PUBLIC_FLAG_AVATAR_ANIMATION=false

# Clerk publishable key (pk_test_*/pk_live_*) — public by design and required.
# NEVER put sk_* secret keys or another privileged credential in an
# EXPO_PUBLIC_* variable.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
