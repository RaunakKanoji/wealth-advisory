# Client environment configuration. Copy to `.env.local` for local development.
#
# Every EXPO_PUBLIC_* variable is bundled into the Expo client and is PUBLIC.
# Never put Gemini keys, Clerk secret keys, database URLs, bank credentials, or
# other privileged credentials in an EXPO_PUBLIC_* variable.

# Public Clerk key used by the Expo client.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Origin of the authenticated API gateway used by native clients.
# For a deployed Expo Router server this is the server origin, for example:
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com
# On web, same-origin /api routes are used when this is omitted.
# EXPO_PUBLIC_API_BASE_URL=

# true = deterministic demo adapters; false = authenticated integration paths.
EXPO_PUBLIC_USE_MOCK_DATA=true

# ---------------------------------------------------------------------------
# SERVER-ONLY variables
# Configure these in the server/deployment environment. Do NOT prefix them
# with EXPO_PUBLIC_ and do not put production values in committed files.
# ---------------------------------------------------------------------------

# Google Gemini API key.
GEMINI_API_KEY=

# Stable Gemini model. Current default used by the server route.
GEMINI_MODEL=gemini-3.8-flash

# Clerk Frontend API / issuer URL used to verify session JWTs server-side.
# Example format: https://<your-clerk-domain>
CLERK_JWT_ISSUER=
