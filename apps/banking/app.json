{
  "expo": {
    "name": "IDBI Wealth Advisory",
    "slug": "wealth-advisory",
    "version": "1.0.0",
    "icon": "./assets/branding/idbi-app-logo.png",
    "orientation": "portrait",
    "splash": {
      "image": "./assets/branding/idbi-app-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#007A6C"
    },
    "scheme": "wealthadvisory",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.wealth-advisory.test1234",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is used to scan QR codes.",
        "NSLocalNetworkUsageDescription": "IDBI Wealth Advisory uses the local network to connect to the development banking service.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.idbi.wealthadvisory",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/idbi-app-logo.png",
        "backgroundColor": "#007A6C"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Camera access is used to scan QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Photo access is used to select a QR image.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/idbi-app-logo.png",
          "backgroundColor": "#007A6C",
          "dark": {
            "backgroundColor": "#007A6C"
          }
        }
      ],
      "expo-secure-store",
      [
        "@clerk/expo",
        {
          "appleSignIn": false,
          "theme": "./clerk-theme.json"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e7e77571-c280-4a83-b26a-afe1f8256ae4"
      }
    },
    "owner": "raunakkanoji"
  }
}
