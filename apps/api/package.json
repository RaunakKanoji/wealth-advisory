{
  "name": "@idbi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.coach.local --watch --import tsx src/server.ts",
    "dev:demo": "node --env-file=.env.coach.local --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:coach": "node --env-file=.env.coach.local --import tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:verify": "tsx src/db/verify.ts",
    "db:verify:coach": "node --env-file=.env.coach.local --import tsx src/db/verify.ts",
    "demo:check": "node --env-file=.env.coach.local --import tsx scripts/demo-check.ts",
    "demo:seed": "node --env-file=.env.coach.local --import tsx src/db/seed.ts",
    "db:check": "tsx src/db/verify.ts",
    "demo:reset": "tsx src/db/seed.ts",
    "smoke:demo": "node --env-file=.env.coach.local --import tsx scripts/smoke-demo.ts",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:test": "tsx scripts/test-db.ts",
    "accounts:test": "tsx scripts/test-accounts.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coach-db": "vitest run --config vitest.coach-db.config.ts",
    "coach:db-check": "tsx src/coach/database-check.ts",
    "dev:coach": "node --env-file=.env.coach.local --import tsx src/server.ts"
    ,"analytics:provision-reader": "node --env-file=.env.coach.local --import tsx scripts/provision-wealth-analytics-reader.ts"
  },
  "dependencies": {
    "@clerk/backend": "^2.28.1",
    "@hono/node-server": "^1.19.2",
    "@neondatabase/serverless": "^1.0.2",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
