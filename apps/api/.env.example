# Server-only configuration. Never copy these values into apps/banking/.env.local
# or any EXPO_PUBLIC_* variable.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=development
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=15000
CLERK_SECRET_KEY=
# Optional verification hardening. In production, set the audience and the
# comma-separated Clerk authorized parties for this deployment.
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=
DEMO_MODE=false
DEMO_USER_ID=usr_demo_a
DEMO_AUTH_ID=demo-customer-a
API_HOST=0.0.0.0
PORT=8080
API_ORIGIN=http://localhost:8080

# Optional internal Wealth Analytics gateway. The mobile app never receives
# this URL or secret; the API uses it after resolving the authenticated user.
VANNA_SERVICE_URL=http://127.0.0.1:8001
VANNA_SERVICE_SECRET=
VANNA_QUERY_TIMEOUT_MS=20000

# Account Aggregator / FIU integration. Keep every value below server-side.
# The integration is disabled until the FIU has been onboarded by the selected
# provider. No AA data or fake data is used while it is disabled.
AA_ENABLED=false
AA_PROVIDER=finvu
AA_API_BASE_URL=
AA_FIU_ID=
AA_CLIENT_API_KEY=
AA_JWS_PRIVATE_KEY=
AA_JWS_PUBLIC_KEY=
AA_JWS_KEY_ID=
AA_WEBHOOK_SECRET=
AA_REQUEST_TIMEOUT_MS=15000
AA_DATA_RETENTION_DAYS=30

# Server-only Gemini configuration. Set an available model explicitly.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Used only when the primary model is temporarily unavailable.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash
